# Database Configuration
# For PostgreSQL (Docker or local):
DATABASE_URL=postgresql+psycopg://stocksense:stocksense123@localhost:5432/stocksense_db
# For SQLite local fallback development (zero-config):
# DATABASE_URL=sqlite+aiosqlite:///./stocksense.db

# Security & Tokens
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
DEV_MODE=true

# Redis (optional cache)
REDIS_URL=redis://localhost:6379/0

# App Environment
ENVIRONMENT=development
PROJECT_NAME="StockSense IMS"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
